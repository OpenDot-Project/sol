{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/managed/OpenDot.Sol.Text/*.csproj", "src/managed/OpenDot.Sol.Diagnostics/*.csproj", "src/managed/OpenDot.Sol.Cst/*.csproj", "src/managed/OpenDot.Sol.Psi/*.csproj", "src/managed/OpenDot.Sol.Ast/*.csproj", "src/managed/OpenDot.Sol.Analysis/*.csproj", "src/managed/OpenDot.Sol.Driver/*.csproj"]
        }
      ],
      "dest": "out/docfx/metadata",
      "disableGitFeatures": true,
      "properties": {
        "TargetFramework": "net10.0-windows",
        "Configuration": "Release"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.md", "toc.yml"],
        "src": "docs"
      },
      {
        "files": ["**/*.yml"],
        "src": "out/docfx/metadata",
        "dest": "api"
      }
    ],
    "dest": "out/docfx/site",
    "resource": [
      { "files": ["spec/**/*.sol", "spec/**/*.md"] }
    ],
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "Sol",
      "_disableContribution": true
    },
    "disableGitFeatures": true
  }
}
