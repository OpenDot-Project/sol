{
  "schema_version": 1,
  "engine": {
    "managed": {
      "name": "libFuzzer with SharpFuzz",
      "package": "SharpFuzz",
      "version": "2.3.0",
      "driver_url": "https://github.com/Metalnem/libfuzzer-dotnet/releases/download/v2025.05.02.0904/libfuzzer-dotnet-windows.exe",
      "driver_sha256": "17af5b3f6ff4d2c57b44b9a35c13051b570eb66f0557d00015df3832709050bf",
      "driver_sha512": "4da2a77d06229a43040f9841bc632a881389a0b8fdcc2d60c8d0b547ccbedee63e7b0a7eca8eeffdba1243d85bdcec3cfe763237650c2f46a1327f8ee401d9a2",
      "driver_bytes": 1512448
    },
    "native": {
      "name": "LLVM libFuzzer",
      "llvm_version": "23.1.3",
      "compiler": "clang-cl",
      "sanitizers": [
        "address"
      ]
    }
  },
  "limits": {
    "maximum_input_bytes": 8192,
    "input_timeout_seconds": 10,
    "rss_limit_mb": 1024,
    "campaigns": {
      "smoke": {
        "seconds_per_target": 20,
        "seed_limit_per_target": 400
      },
      "nightly": {
        "seconds_per_target": 300,
        "seed_limit_per_target": 2000
      }
    }
  },
  "targets": [
    {
      "name": "frontend",
      "corpus": "fuzz/corpus/frontend",
      "mode": "managed",
      "entry_argument": "coverage-frontend",
      "instrumented_assemblies": [
        "OpenDot.Sol.Cst.dll",
        "OpenDot.Sol.Text.dll",
        "OpenDot.Sol.Diagnostics.dll"
      ]
    },
    {
      "name": "semantic",
      "corpus": "fuzz/corpus/semantic",
      "mode": "managed",
      "entry_argument": "coverage-semantic",
      "instrumented_assemblies": [
        "OpenDot.Sol.Analysis.dll",
        "OpenDot.Sol.Ast.dll",
        "OpenDot.Sol.Psi.dll",
        "OpenDot.Sol.Cst.dll",
        "OpenDot.Sol.Text.dll",
        "OpenDot.Sol.Diagnostics.dll"
      ]
    },
    {
      "name": "runtime",
      "corpus": "fuzz/corpus/runtime",
      "mode": "native",
      "native_target": "runtime"
    },
    {
      "name": "backend",
      "corpus": "fuzz/corpus/backend",
      "mode": "native",
      "native_target": "backend"
    },
    {
      "name": "gc",
      "corpus": "fuzz/corpus/gc",
      "mode": "native",
      "native_target": "gc"
    }
  ]
}
