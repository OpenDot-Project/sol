PROJECT_NAME           = "Sol native implementation"
PROJECT_BRIEF          = "LLVM bridge, native SolRT bootstrap, and Windows launcher"
OUTPUT_DIRECTORY       = out/doxygen
OUTPUT_LANGUAGE        = English
INPUT                   = src/native
FILE_PATTERNS           = *.h *.cpp *.md
RECURSIVE               = YES
USE_MDFILE_AS_MAINPAGE  = src/native/README.md
FULL_PATH_NAMES         = YES
STRIP_FROM_PATH         = .
EXTRACT_ALL             = YES
EXTRACT_STATIC          = YES
EXTRACT_PRIVATE         = NO
CPP_CLI_SUPPORT         = YES
ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION          = YES
EXPAND_ONLY_PREDEF       = YES
PREDEFINED              = SOL_RT_API=
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = FAIL_ON_WARNINGS
WARN_LOGFILE            = out/doxygen/warnings.log
GENERATE_HTML           = YES
GENERATE_XML            = YES
GENERATE_LATEX          = NO
SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
HAVE_DOT                = NO
QUIET                   = YES
